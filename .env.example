# Coimbatore Smart City Digital Twin Environment Configuration

# App Configuration
APP_NAME="Coimbatore Smart City Digital Twin"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="coimbatore-smart-city-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Hosts & Ports
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database Configuration
# Local SQLite default (runs out-of-the-box without Docker/PostgreSQL installation):
DATABASE_URL="sqlite:///./backend/app.db"
# Production / Docker PostgreSQL + TimescaleDB + PostGIS URL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/coimbatore_twin"

# Redis Cache & PubSub
REDIS_URL="redis://localhost:6379/0"
USE_REDIS_CACHE=false

# External APIs
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_AIR_QUALITY_URL="https://air-quality-api.open-meteo.com/v1/air-quality"
COIMBATORE_LAT=11.0168
COIMBATORE_LON=76.9558

# AI Assistant Configuration (Optional external LLM - falls back to grounded rule engine if blank)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Simulation Engine
SIMULATION_ENABLED=true
SIMULATION_TICK_SECONDS=2
